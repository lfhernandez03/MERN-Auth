{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "rootDir": "./src",      // Carpeta de entrada de tus archivos .ts
    "outDir": "./dist",      // Carpeta de salida para los .js compilados
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },
  "include": ["src/**/*"],        // Incluye solo los archivos del backend
  "exclude": ["node_modules", "dist"]
}